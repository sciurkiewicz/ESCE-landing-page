{
  "name": "esce-landing-page",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "setup": "node scripts/setup-local.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "preview": "npm run build && npm start",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node tests/cms-smoke.mjs",
    "test:parallax": "node tests/parallax-smoke.mjs"
  },
  "dependencies": {
    "dompurify": "^3.3.0",
    "marked": "^17.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "playwright-core": "^1.65.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
