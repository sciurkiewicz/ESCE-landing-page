# Skopiuj ten plik do .env i ustaw własne hasło (co najmniej 12 znaków).
# Hasło odczytuje wyłącznie serwer. Nie używaj prefiksu VITE_.
ADMIN_PASSWORD=
PORT=3000
HOST=127.0.0.1
# Na publicznym hostingu z HTTPS ustaw NODE_ENV=production i COOKIE_SECURE=true.
COOKIE_SECURE=false
# Za reverse proxy ustaw docelową domenę, np. https://twoja-domena.pl
# SITE_ORIGIN=

# Najnowsze filmy z kanału YouTube (bez klucza API).
# Podaj link do kanału /@nazwa lub /channel/UC... albo jego identyfikator.
YOUTUBE_CHANNEL_URL=
# YOUTUBE_CHANNEL_ID=
